# ─────────────────────────────────────────────────────────────────────
# Wichtig für das Deployment des Mindmap Editors (wie beim PAP-Editor)
#
# index.html darf NICHT im Browser-Cache liegen bleiben: lädt der Browser
# eine alte index.html und dazu neue Skripte, passen HTML und Skript nicht
# mehr zusammen. Die Skripte und mindmap.css haben einen Cache-Buster (?v=N)
# und dürfen gecacht werden.
#
# Achtung: Diese Datei beginnt mit einem Punkt und wird von vielen FTP-
# Programmen ausgeblendet – beim Hochladen "versteckte Dateien anzeigen".
#
# nginx (z. B. Plesk ohne Apache) beachtet .htaccess nicht. Dann in Plesk
# unter "Apache & nginx Einstellungen" bei den nginx-Direktiven eintragen:
#
#   location = /index.html { add_header Cache-Control "no-cache, must-revalidate"; }
#   location = /           { add_header Cache-Control "no-cache, must-revalidate"; }
#   location ^~ /api/data/ { deny all; }
# ─────────────────────────────────────────────────────────────────────

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Datenschutz und Sicherheit (siehe DEPLOY.md und DATENSCHUTZ.md)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'none'"
</IfModule>

# Nur über HTTPS betreiben: http:// auf https:// umleiten
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

AddDefaultCharset UTF-8
